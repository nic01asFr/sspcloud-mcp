{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "title": "Image",
      "description": "Conteneur publié sur GitHub Container Registry.",
      "properties": {
        "repository": {
          "type": "string",
          "title": "Registre",
          "default": "ghcr.io/nic01asfr/sspcloud-mcp",
          "x-onyxia": { "hidden": true }
        },
        "tag": {
          "type": "string",
          "title": "Version de l'image",
          "default": "latest",
          "x-onyxia": { "hidden": true }
        },
        "pullPolicy": {
          "type": "string",
          "default": "Always",
          "enum": ["Always", "IfNotPresent"],
          "x-onyxia": { "hidden": true }
        }
      }
    },
    "app": {
      "type": "object",
      "title": "Serveur MCP",
      "description": "Paramètres du serveur MCP Agent Compute.",
      "properties": {
        "host": {
          "type": "string",
          "title": "Domaine public",
          "description": "Hostname public du serveur (TLS auto). Renseigné par Onyxia.",
          "default": "",
          "x-onyxia": {
            "hidden": true,
            "overwriteDefaultWith": "user-{{user.idep}}-mcp.{{k8s.domain}}"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "title": "Ingress",
      "x-onyxia": { "hidden": true },
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "x-onyxia": {
            "hidden": true,
            "overwriteDefaultWith": "k8s.ingress"
          }
        },
        "className": {
          "type": "string",
          "default": "onyxia",
          "x-onyxia": {
            "hidden": true,
            "overwriteDefaultWith": "{{k8s.ingressClassName}}"
          }
        }
      }
    },
    "onyxia_user": {
      "type": "string",
      "title": "Identifiant Onyxia",
      "description": "Renseigné automatiquement.",
      "default": "",
      "x-onyxia": {
        "hidden": true,
        "overwriteDefaultWith": "{{user.idep}}"
      }
    },
    "appAuth": {
      "type": "object",
      "title": "Clé API (Bearer)",
      "x-onyxia": { "hidden": true },
      "properties": {
        "token": {
          "type": "string",
          "title": "Clé API",
          "description": "Remplie par Onyxia. Affichée dans les notes du service.",
          "default": "",
          "x-onyxia": {
            "hidden": true,
            "overwriteDefaultWith": "{{service.oneTimePassword}}"
          }
        }
      }
    },
    "global": {
      "type": "object",
      "x-onyxia": { "hidden": true },
      "properties": {
        "suspend": {
          "type": "boolean",
          "default": false,
          "x-onyxia": { "hidden": true }
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Ressources",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "title": "CPU", "default": "100m" },
            "memory": { "type": "string", "title": "RAM", "default": "512Mi" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "title": "CPU max", "default": "1" },
            "memory": { "type": "string", "title": "RAM max", "default": "2Gi" }
          }
        }
      }
    }
  }
}
